# R project file
^.*\.Rproj$
^\.Rproj\.user$

# OS files
^\.DS_Store$

# Build artifacts
^.*\.tar\.gz$
^.*\.Rcheck$
^.*\.BiocCheck$
^Meta$

# Development-only (not shipped in package tarball)
^examples$
^data-raw$
^scratch$

# pkgdown website files (for GitHub Pages only, not part of package)
^docs$
^pkgdown$
^_pkgdown\.yml$

# man/figures (images embedded in README, not needed in package)
^man/figures$
